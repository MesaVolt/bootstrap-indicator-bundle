{
    "name": "mesavolt/bootstrap-indicator-bundle",
    "description": "Symfony toolbar indicator with the current Bootstrap viewport breakpoint",
    "homepage": "https://github.com/MesaVolt/bootstrap-indicator-bundle",
    "readme": "README.md",
    "authors": [
        {
            "name": "MesaVolt",
            "homepage": "https://mesavolt.com"
        }
    ],
    "keywords": ["symfony", "toolbar", "profiler", "bootstrap", "css", "viewport", "breakpoint"],
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4.1",
        "composer-runtime-api": ">=2",
        "composer/semver": "^3.5",
        "symfony/framework-bundle": "*",
        "symfony/web-profiler-bundle": "*"
    },
    "require-dev": {
        "symfony/dependency-injection": "*"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Mesavolt\\BootstrapIndicatorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mesavolt\\BootstrapIndicatorBundle\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.* || 8.1.* || 8.2.*"
        }
    }
}
